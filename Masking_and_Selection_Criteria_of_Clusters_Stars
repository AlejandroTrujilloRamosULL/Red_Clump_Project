Masking and selection criteria of cluster stars:
-----------------------------------------------

**# 1. Astrometric excess noise — excludes stars with unreliable astrometric data**

mask_astrometric_excess_noise = (astrometric_excess_noise < 1)

# 2. RUWE (Renormalized Unit Weight Error) — chi_squared based statistic fit which 
filters out sources with bad astrometric data

mask_ruwe = (ruwe < 1.8)

# 3. Parallax range — considered from a distribution study of parallax,
considered values within ±1σ of the median parallax

mask_parallax_range = 
    (parallax > median_parallax - 1*std_parallax) &
    (parallax < median_parallax + 1*std_parallax)

# 4. Photometric BP/RP excess factor — filters out problematic photometry

mask_phot_bp_rp = (phot_bp_rp_excess_factor < 1.3)

# 5. Proper motion range —considered from a distribution study of proper motion, 
considered values within ±1σ of the median proper motion

mask_pm_range_2 = 
    (pm > median_pm - 1*std_pm) &
    (pm < median_pm + 1*std_pm)


# 6. Parallax_over_error — ensures reliable distance estimates,
indicator of the Signal to Noise ratio (S/N) of distance measurements

mask_parallax_over_error = (parallax_over_error > 4)
